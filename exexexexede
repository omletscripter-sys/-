local ExtraModule = {}

function ExtraModule.Init(deps)
    local Plr = deps.Plr
    local ReplicatedStorage = deps.ReplicatedStorage
    local Workspace = deps.Workspace
    local VirtualInputManager = deps.VirtualInputManager
    local GuiService = deps.GuiService
    local WindUI = deps.WindUI
    local PauseFarms = deps.PauseFarms
    local ResumeFarms = deps.ResumeFarms

    local Net = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net")
    local JobsRemote = Net:WaitForChild("RF/JobsRemoteFunction")
    local CraftRemote = Net:WaitForChild("RF/Craft")
    local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")

    local State = {
        AutoFish = false,
        AutoBuyBait = false,
        AutoSellFish = false,
        AutoRoll = false,
        AutoStore = false,
        AutoStats = false,
        AutoBuyDealer = false,
        IsRolling = false,
        TotalFishCaught = 0,
        SellInterval = 60,
        StatsPoint = 1,
        SelectedStats = {},
        TargetFruit = nil,
        LastCheckedRestockTime = 0,
        StatsInterval = 5,
        RollInterval = 60, 
    }

    -- ═══════════════════════════════════════
    -- ماهیگیری
    -- ═══════════════════════════════════════
    local CastChargeTime = 0.65
    local FishingActive = false

    local function GetCastPos()
        local Char = Plr.Character
        if Char and Char:FindFirstChild("HumanoidRootPart") then
            return Char.HumanoidRootPart.Position
                + (Char.HumanoidRootPart.CFrame.LookVector * 50)
                - Vector3.new(0, 12, 0)
        end
        return Vector3.new(0, 0, 0)
    end

    local function TapClick()
        local x = Workspace.CurrentCamera.ViewportSize.X / 2
        local y = Workspace.CurrentCamera.ViewportSize.Y / 2
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end

    local function PerfectCast()
        local FishingRequest = ReplicatedStorage:FindFirstChild("FishReplicated")
            and ReplicatedStorage.FishReplicated:FindFirstChild("FishingRequest")
        local x = Workspace.CurrentCamera.ViewportSize.X / 2
        local y = Workspace.CurrentCamera.ViewportSize.Y / 2

        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(CastChargeTime)
        pcall(function()
            if FishingRequest then
                FishingRequest:InvokeServer("CastLineAtLocation", GetCastPos(), 100, true)
            end
        end)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end

    local function BuyBait()
        if not State.AutoBuyBait then return end
        pcall(function()
            local baitCount = 0
            local inv = CommF:InvokeServer("getInventory")
            if inv then
                for _, item in pairs(inv) do
                    local name = tostring(item.Name or ""):lower()
                    if name == "basic bait" or name == "bait" then
                        baitCount = item.Count or 0
                        break
                    end
                end
            end

            if baitCount < 15 then
                CraftRemote:InvokeServer("Craft", "Basic Bait", 1, {})
                WindUI:Notify({
                    Title = "خرید بایت",
                    Content = "یک بسته بایت خریداری شد",
                    Duration = 2
                })
            end
        end)
    end

    local function SellFish()
        if not State.AutoSellFish then return end
        pcall(function()
            JobsRemote:InvokeServer("FishingNPC", "SellFish")
            WindUI:Notify({
                Title = "فروش ماهی",
                Content = "ماهی‌ها فروخته شدند",
                Duration = 2
            })
        end)
    end

    local LastSellTime = 0

    task.spawn(function()
        while true do
            pcall(function()
                if not State.AutoFish then
                    FishingActive = false
                    task.wait(0.5)
                    return
                end
                if FishingActive then task.wait(0.1); return end

                local Character = Plr.Character
                if not Character then task.wait(0.5); return end

                local Backpack = Plr.Backpack
                local Humanoid = Character:FindFirstChild("Humanoid")
                local Head = Character:FindFirstChild("Head")
                if not Humanoid or not Head then task.wait(0.5); return end

                BuyBait()

                if State.AutoSellFish and (tick() - LastSellTime) > State.SellInterval then
                    LastSellTime = tick()
                    SellFish()
                end

                local tool = Character:FindFirstChild("Fishing Rod")
                    or Backpack:FindFirstChild("Fishing Rod")
                if not tool then task.wait(1); return end

                if tool.Parent == Backpack then
                    Humanoid:EquipTool(tool)
                    pcall(function()
                        local FR = ReplicatedStorage:FindFirstChild("FishReplicated")
                            and ReplicatedStorage.FishReplicated:FindFirstChild("FishingRequest")
                        if FR then FR:InvokeServer("RodEquipped") end
                    end)
                    task.wait(0.4)
                end

                FishingActive = true
                PerfectCast()

                local FishDetected = false
                local StartTime = tick()
                local oldAttachments = {}
                for _, v in pairs(Head:GetChildren()) do
                    if v:IsA("Attachment") then oldAttachments[v] = true end
                end

                repeat
                    task.wait()
                    for _, v in pairs(Head:GetChildren()) do
                        if v:IsA("Attachment") and not oldAttachments[v] then
                            FishDetected = true
                            break
                        end
                    end
                    if not Character:FindFirstChild("Fishing Rod") then break end
                until FishDetected or (tick() - StartTime > 40) or not State.AutoFish

                if FishDetected and State.AutoFish then
                    TapClick()
                    task.wait(2)
                    pcall(function()
                        local FR = ReplicatedStorage:FindFirstChild("FishReplicated")
                            and ReplicatedStorage.FishReplicated:FindFirstChild("FishingRequest")
                        if FR then FR:InvokeServer("Catch", 1, 0, 1) end
                    end)
                    State.TotalFishCaught = State.TotalFishCaught + 1
                    task.wait(1)
                else
                    if State.AutoFish then TapClick(); task.wait(0.5) end
                end

                FishingActive = false
            end)
            task.wait(0.5)
        end
    end)

    -- ═══════════════════════════════════════
    -- رول گاچا
    -- ═══════════════════════════════════════
    local function CheckGachaReady()
        local isReady = false
        pcall(function()
            local result = CommF:InvokeServer("Cousin", "CheckCanBuyType", "DLCBoxData")
            local outputText = tostring(result)
            if outputText == "1" or outputText == "true" or outputText == "0" then
                isReady = true
            end
        end)
        return isReady
    end

    local function CloseGachaUI()
        task.wait(1.5)
        pcall(function()
            local playerGui = Plr.PlayerGui
            local closeNames = {
                "close", "exit", "back", "bottem", "botem",
                "bottom", "btn", "closebtn", "closebotemn",
                "closebotem", "closebottom", "closebutton",
            }

            local function searchAndClick(parent, depth)
                if depth > 10 then return false end
                for _, obj in pairs(parent:GetChildren()) do
                    if obj:IsA("GuiButton") and obj.Visible then
                        local nm = string.lower(obj.Name)
                        local tx = string.lower(tostring(obj.Text or ""))
                        local isClose = false

                        for _, cn in pairs(closeNames) do
                            if nm:find(cn) then isClose = true; break end
                        end
                        if tx == "x" or tx == "close" or tx == "exit"
                            or tx == "✕" or tx == "✖" or tx == "❌" then
                            isClose = true
                        end

                        if isClose then
                            pcall(function() obj.MouseButton1Click:Fire() end)
                            local absPos = obj.AbsolutePosition
                            local absSize = obj.AbsoluteSize
                            local cx = absPos.X + absSize.X / 2
                            local cy = absPos.Y + absSize.Y / 2
                            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                            task.wait(0.05)
                            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                            return true
                        end
                    end
                    if searchAndClick(obj, depth + 1) then return true end
                end
                return false
            end

            searchAndClick(playerGui, 0)
        end)
    end

    local function DoRoll()
        if State.IsRolling then return end
        State.IsRolling = true
        if PauseFarms then PauseFarms() end

        WindUI:Notify({Title = "گاچا", Content = "در حال رول زدن...", Duration = 3})

        local success = false
        pcall(function()
            local result = CommF:InvokeServer("Cousin", "BuyBox", "DLCBoxData")
            if result ~= nil and result ~= false then
                success = true
            end
        end)

        task.wait(2.5)
        CloseGachaUI()
        task.wait(1)

        State.IsRolling = false
        if ResumeFarms then ResumeFarms() end

        if success then
            WindUI:Notify({Title = "گاچا", Content = "رول زده شد! ✅", Duration = 3})
        end
    end

    task.spawn(function()
        while true do
            pcall(function()
                if not State.AutoRoll then return end
                if State.IsRolling then return end
                
                if CheckGachaReady() then
                    DoRoll()
                end
            end)
            task.wait(State.RollInterval or 60)
        end
    end)

    -- ═══════════════════════════════════════
    -- استور فروت
    -- ═══════════════════════════════════════
    local function GetStoreName(fruitName)
        local baseName = fruitName:gsub("%s*Fruit%s*$", ""):gsub("%s+$", "")
        return baseName .. "-" .. baseName
    end

    local function TryStoreFruit(tool, character, humanoid)
        local fruitName = tool.Name
        local storeName = GetStoreName(fruitName)

        if tool.Parent == Plr.Backpack then
            humanoid:EquipTool(tool)
            task.wait(0.6)
        end

        local equippedInstance = character:FindFirstChild(fruitName)
            or character:FindFirstChildWhichIsA("Tool")

        if not equippedInstance then
            humanoid:UnequipTools()
            task.wait(0.3)
            return false
        end

        local storeSuccess = false
        pcall(function()
            CommF:InvokeServer("StoreFruit", storeName, equippedInstance)
            storeSuccess = true
        end)

        task.wait(0.4)
        humanoid:UnequipTools()
        task.wait(0.3)

        if storeSuccess then
            WindUI:Notify({
                Title = "استور فروت",
                Content = "فروت استور شد: " .. fruitName,
                Duration = 2
            })
        end

        return storeSuccess
    end

    task.spawn(function()
        while task.wait(3) do
            pcall(function()
                if not State.AutoStore then return end

                local Character = Plr.Character
                if not Character then return end

                local Humanoid = Character:FindFirstChild("Humanoid")
                if not Humanoid then return end

                for _, tool in pairs(Plr.Backpack:GetChildren()) do
                    if tool:IsA("Tool") and tool.ToolTip == "Blox Fruit" then
                        TryStoreFruit(tool, Character, Humanoid)
                        task.wait(0.5)
                    end
                end

                for _, tool in pairs(Character:GetChildren()) do
                    if tool:IsA("Tool") and tool.ToolTip == "Blox Fruit" then
                        local fruitName = tool.Name
                        local storeName = GetStoreName(fruitName)

                        pcall(function()
                            CommF:InvokeServer("StoreFruit", storeName, tool)
                            WindUI:Notify({
                                Title = "استور فروت",
                                Content = "فروت استور شد: " .. fruitName,
                                Duration = 2
                            })
                        end)
                        task.wait(0.5)
                    end
                end
            end)
        end
    end)

    -- ═══════════════════════════════════════
    -- اتو استتس
    -- ═══════════════════════════════════════
    local StatMap = {
        ["Melee"]       = "Melee",
        ["Defense"]     = "Defense",
        ["Sword"]       = "Sword",
        ["Gun"]         = "Gun",
        ["Demon Fruit"] = "Demon_Fruit",
    }

    task.spawn(function()
        while true do
            pcall(function()
                if not State.AutoStats then return end
                local ss = State.SelectedStats or {}
                if not next(ss) then return end

                local pts = math.max(1, math.min(State.StatsPoint or 1, 4000))

                for statName, _ in pairs(ss) do
                    local realName = StatMap[statName] or statName
                    pcall(function()
                        CommF:InvokeServer("AddPoint", realName, pts)
                    end)
                    task.wait(0.1)
                end
            end)
            task.wait(State.StatsInterval or 5)
        end
    end)

    -- ═══════════════════════════════════════
    -- اتو خرید فروت از دیلر (کاملا اصلاح شده)
    -- ═══════════════════════════════════════
    
    -- تابع دریافت دقیق پول (Beli) پلیر
    local function GetPlayerBeli()
        local data = Plr:FindFirstChild("Data")
        if data and data:FindFirstChild("Beli") then
            return data.Beli.Value
        end
        return 0
    end

    task.spawn(function()
        while task.wait(30) do
            pcall(function()
                if not State.AutoBuyDealer then return end
                local targetFruit = State.TargetFruit
                if not targetFruit then return end

                -- جلوگیری از اسپم سرور (چک هر 1 دقیقه یکبار)
                local now = tick()
                local lastCheck = State.LastCheckedRestockTime or 0
                if (now - lastCheck) < 60 then return end
                State.LastCheckedRestockTime = now

                -- دریافت استاک فروت ها
                local stock = nil
                pcall(function()
                    stock = CommF:InvokeServer("GetFruits", false)
                end)
                if type(stock) ~= "table" then return end

                -- تمیز کردن اسم هدف (مثلا "rubber" از "Rubber-Rubber")
                local targetClean = string.lower(string.split(targetFruit, "-")[1] or targetFruit)
                targetClean = targetClean:gsub(" fruit", ""):gsub("%s+$", "")

                local playerMoney = GetPlayerBeli()

                for _, item in pairs(stock) do
                    -- بررسی اینکه تو استاک باشه و اسم/قیمت داشته باشه
                    if item.OnSale and item.Name and item.Price then
                        local itemNameLower = string.lower(item.Name)
                        
                        -- اگه فروت مورد نظر بود
                        if itemNameLower:find(targetClean) then
                            
                            -- چک کردن پول پلیر
                            if playerMoney >= item.Price then
                                pcall(function()
                                    -- ریموت اصلی که با RemoteSpy پیدا کردی
                                    local success = CommF:InvokeServer("PurchaseRawFruit", item.Name, false)
                                    
                                    WindUI:Notify({
                                        Title = "خرید فروت موفق",
                                        Content = "فروت " .. item.Name .. " با موفقیت خریداری شد!",
                                        Duration = 5
                                    })
                                end)
                            else
                                -- پول ناکافی
                                WindUI:Notify({
                                    Title = "پول ناکافی برای فروت",
                                    Content = "فروت " .. item.Name .. " استاک شد اما پول شما کافی نیست! (قیمت: " .. item.Price .. ")",
                                    Duration = 5
                                })
                            end
                            
                            -- بعد از پیدا کردن فروت حلقه رو میشکنیم تا بقیه رو چک نکنه
                            break
                        end
                    end
                end
            end)
        end
    end)

    -- ═══════════════════════════════════════
    -- API
    -- ═══════════════════════════════════════
    local API = {}

    function API.Set(key, value)
        State[key] = value
    end

    function API.Get(key)
        return State[key]
    end

    return API
end

return ExtraModule
